{
  "name": "fuehlich-backend",
  "version": "1.0.0",
  "description": "Backend für FühlIch / Momento: Votes-Statistik, Fremdeinschätzungs-Auflösung und Ausliefern des Frontends",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind-input.css -o ./public/tailwind.css --watch"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}